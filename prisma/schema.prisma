generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERADOR
  CLIENTE
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  PROCESSADO
  CANCELADO
}

enum StatusEquipamento {
  RECEBIDO
  EM_TRIAGEM
  EM_DESMONTAGEM
  TESTE_COMPONENTES
  PRONTO_DESCARTE
  PRONTO_REUSO
  DESCARTE
  REUSO
}

enum CondicaoFisica {
  NAO_AVALIADO
  BOM
  REGULAR
  RUIM
  INSERVIVEL
}

enum TipoOrganizacao {
  gerador
  operador_logistico
  desmontadora
  comprador
}

enum ApiScope {
  RASTREABILIDADE_READ
  LOTES_READ
  LOTES_WRITE
  RELATORIOS_READ
}

enum CategoriaAnalise {
  EFICIENCIA_OPERACIONAL
  RENTABILIDADE
  VIDA_UTIL
}

enum OrigemAnalise {
  AGENDADO
  MANUAL
}

enum StatusRelatorioJob {
  PENDENTE
  PROCESSANDO
  CONCLUIDO
  FALHA
}

enum FormatoRelatorio {
  CSV
  JSON
}

model Usuario {
  id            String         @id @default(uuid())
  nome          String
  email         String         @unique
  senha         String
  role          Role           @default(OPERADOR)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  movimentacoes Movimentacao[]

  @@map("usuarios")
}

model Organizacao {
  id        String          @id @default(uuid())
  nome      String
  cnpj      String          @unique
  tipo      TipoOrganizacao
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  contrato  Contrato?
  lotes     Lote[]
  apiKeys   ApiKey[]

  @@map("organizacoes")
}

model Contrato {
  id             String      @id @default(uuid())
  numeroContrato String      @unique
  clausulas      Json?
  vigenciaInicio DateTime
  vigenciaFim    DateTime
  organizacaoId  String      @unique
  organizacao    Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("contratos")
}

model Lote {
  id              String        @id @default(uuid())
  codigo          String        @unique
  status          StatusLote    @default(RECEBIDO)
  dataRecebimento DateTime      @default(now())
  organizacaoId   String
  organizacao     Organizacao   @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  equipamentos    Equipamento[]

  @@map("lotes")
}

model Equipamento {
  id                  String            @id @default(uuid())
  codigoBarrasInterno String            @unique
  tipo                String
  marca               String?
  modelo              String?
  condicaoFisica      CondicaoFisica    @default(NAO_AVALIADO)
  anoFabricacao       Int?
  dataAvaliacao       DateTime?
  valorRecuperacao    Decimal?          @db.Decimal(12, 2)
  status              StatusEquipamento @default(RECEBIDO)
  version             Int               @default(0)
  loteId              String
  lote                Lote              @relation(fields: [loteId], references: [id], onDelete: Restrict)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  movimentacoes       Movimentacao[]

  @@map("equipamentos")
}

model Movimentacao {
  id             String            @id @default(uuid())
  dataHora       DateTime          @default(now())
  equipamentoId  String
  equipamento    Equipamento       @relation(fields: [equipamentoId], references: [id], onDelete: Restrict)
  usuarioId      String
  usuario        Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  statusAnterior StatusEquipamento
  statusNovo     StatusEquipamento
  observacao     String?

  @@map("movimentacoes")
}

model ApiKey {
  id              String         @id @default(uuid())
  nome            String
  prefixo         String         @unique
  hash            String
  scopes          ApiScope[]
  limitePorMinuto Int            @default(60)
  ativa           Boolean        @default(true)
  organizacaoId   String
  organizacao     Organizacao    @relation(fields: [organizacaoId], references: [id], onDelete: Restrict)
  ultimoUsoEm     DateTime?
  revogadaEm      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  relatorioJobs   RelatorioJob[]

  @@map("api_keys")
}

model RelatorioAnalitico {
  id         String             @id @default(uuid())
  categoria  CategoriaAnalise
  origem     OrigemAnalise
  parametros Json?
  resultado  Json
  geradoEm   DateTime           @default(now())
  previsoes  PrevisaoVidaUtil[]

  @@index([categoria, geradoEm])
  @@map("relatorios_analiticos")
}

model PrevisaoVidaUtil {
  id                           String             @id @default(uuid())
  relatorioId                  String
  relatorio                    RelatorioAnalitico @relation(fields: [relatorioId], references: [id], onDelete: Restrict)
  tipoEquipamento              String
  amostras                     Int
  inclinacao                   Float?
  intercepto                   Float?
  r2                           Float?
  vidaUtilEstimadaAnos         Float?
  idadeInservivelObservadaAnos Float?
  createdAt                    DateTime           @default(now())

  @@index([tipoEquipamento, createdAt])
  @@map("previsoes_vida_util")
}

model RelatorioJob {
  id           String             @id @default(uuid())
  categoria    CategoriaAnalise
  formato      FormatoRelatorio
  status       StatusRelatorioJob @default(PENDENTE)
  parametros   Json?
  tentativas   Int                @default(0)
  erro         String?
  resultado    String?            @db.Text
  apiKeyId     String
  apiKey       ApiKey             @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  iniciadoEm   DateTime?
  concluidoEm  DateTime?
  updatedAt    DateTime           @updatedAt

  @@index([apiKeyId, createdAt])
  @@map("relatorio_jobs")
}