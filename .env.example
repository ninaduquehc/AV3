DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5435/greencode_db?schema=public"
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
PORT=3000
CORS_ORIGIN="*"
REDIS_URL="redis://localhost:6380"
# Processa a fila de relatórios no mesmo processo da API.
# Com false, rode o worker à parte: npm run worker
ENABLE_WORKER=true
# Agendamento do recálculo das análises (cron de 5 campos; padrão: todo dia às 02:00)
ANALYTICS_CRON="0 2 * * *"
ANALYTICS_TZ="America/Sao_Paulo"
# Com false, o agendamento não é registrado
ENABLE_SCHEDULER=true